# TiDB Cloud Database Configuration
# ดูข้อมูลการเชื่อมต่อได้จาก TiDB Cloud Console > Cluster > Connect
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=auth_bypass_demo

# JWT Secret
JWT_SECRET=auth_bypass_demo_jwt_secret_pnru_2026

# Session Secret
SESSION_SECRET=auth_bypass_session_secret_2026

# Server Port
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
